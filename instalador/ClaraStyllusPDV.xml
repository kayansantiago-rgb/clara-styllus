<!--
  Configuração do serviço do Windows (WinSW). O serviço mantém o servidor do PDV
  rodando em segundo plano desde que o computador liga, sem janela aberta.
  %BASE% é a pasta de instalação; %ProgramData% normalmente é C:\ProgramData.
-->
<service>
  <id>ClaraStyllusPDV</id>
  <name>Clara Styllus PDV</name>
  <description>Servidor local do ponto de venda Clara Styllus (http://localhost:3456).</description>
  <executable>%BASE%\node\node.exe</executable>
  <arguments>--disable-warning=ExperimentalWarning "%BASE%\app\server.js"</arguments>
  <env name="BANCO" value="%ProgramData%\ClaraStyllus\dados\clara-styllus.db"/>
  <env name="PORTA" value="3456"/>
  <workingdirectory>%BASE%\app</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>15 sec</stoptimeout>
  <logpath>%ProgramData%\ClaraStyllus\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
</service>
